{
  "name": "storage-assistant",
  "version": "0.6.2",
  "description": "See what's taking up space in a folder on your Mac as a treemap, and clear it with one click: Move to Trash, Delete permanently or Remove Download. Nothing changes unless you click.",
  "author": {
    "name": "Akshay Rakheja"
  },
  "repository": "https://github.com/akshay-rakheja/storage-assistant",
  "keywords": [
    "storage",
    "disk",
    "treemap",
    "macos"
  ],
  "mcpServers": {
    "storage": {
      "type": "stdio",
      "command": "python3",
      "args": [
        "${CLAUDE_PLUGIN_ROOT}/run.py",
        "plugin"
      ],
      "env": {
        "PYTHONDONTWRITEBYTECODE": "1"
      }
    }
  },
  "homepage": "https://github.com/akshay-rakheja/storage-assistant",
  "license": "MIT"
}
